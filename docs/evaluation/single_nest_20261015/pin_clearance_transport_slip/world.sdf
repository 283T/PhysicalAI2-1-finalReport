      <joint name="P3_termination" type="fixed">
        <parent>P3_wire_8</parent>
        <child>P3</child>
        <pose>-.02 0 0 0 0 0</pose>
      </joint>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_model_pose>false</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>30</update_frequency>
        <topic>/multi_harness/poses</topic>
      </plugin>
    </model>
    <model name="inspection_camera">
      <static>true</static>
      <link name="inspection_camera_link">
        <gravity>true</gravity>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
        <pose>-0.3 0.7 0.32 0 0.24135549057540379 -1.5707963267948966</pose>
        <sensor name="inspection_rgbd" type="rgbd_camera">
          <always_on>true</always_on>
          <update_rate>1</update_rate>
          <topic>/factory/inspection_rgbd</topic>
          <camera>
            <horizontal_fov>1.1</horizontal_fov>
            <image>
              <width>960</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>3</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
