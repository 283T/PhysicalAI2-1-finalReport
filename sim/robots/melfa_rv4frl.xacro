<?xml version="1.0"?>
<!-- Project wrapper: upstream geometry only, no real hardware or Fortress control plugin. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="melfa_rv4frl">
  <xacro:arg name="prefix" default=""/>
  <xacro:include filename="$(find melfa_description)/urdf/rv4frl/rv4frl_macro.xacro"/>
  <link name="world"/>
  <xacro:rv4frl parent="world" prefix="$(arg prefix)">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:rv4frl>
</robot>
